$viewModel = $block->getData('viewModel');
$customer = $viewModel->customer();
?>
<div class="zero-quote-request grid gap-8 lg:grid-cols-[1fr_24rem]">
    <section aria-labelledby="quote-lines-title">
        <h2 id="quote-lines-title" class="text-lg font-semibold mb-3"><?= $escaper->escapeHtml(__('What you ask about')) ?></h2>
        <div class="overflow-x-auto">
            <table class="table" data-quote-lines>
                <thead>
                    <tr>
                        <th scope="col"><?= $escaper->escapeHtml(__('Product')) ?></th>
                        <th scope="col" class="text-end"><?= $escaper->escapeHtml(__('Qty')) ?></th>
                        <th scope="col" class="text-end"><?= $escaper->escapeHtml(__('Price Now')) ?></th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($viewModel->cartLines() as $line): ?>
                        <tr>
                            <td>
                                <?= $escaper->escapeHtml($line['name']) ?>
                                <?php foreach ($line['options'] as $option): ?>
                                    <span class="block text-xs text-base-content/60"><?= $escaper->escapeHtml($option['label'] . ': ' . $option['value']) ?></span>
                                <?php endforeach; ?>
                            </td>
                            <td class="text-end tabular-nums"><?= (float) $line['qty'] ?></td>
                            <td class="text-end tabular-nums"><?= $escaper->escapeHtml($viewModel->money($line['price'])) ?></td>
                        </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>
        </div>
        <p class="text-sm text-base-content/70 mt-3">
            <a class="link" href="<?= $escaper->escapeUrl($block->getUrl('checkout/cart')) ?>"><?= $escaper->escapeHtml(__('Change the cart')) ?></a>
        </p>
    </section>
    <form method="post" action="<?= $escaper->escapeUrl($block->getUrl('quotes/request/save')) ?>" class="flex flex-col gap-3" data-quote-form>
        <?= $block->getBlockHtml('formkey') ?>
        <input type="hidden" name="source" value="cart">
        <h2 class="text-lg font-semibold"><?= $escaper->escapeHtml(__('Your details')) ?></h2>
        <label class="flex flex-col gap-1 text-sm"><span><?= $escaper->escapeHtml(__('Name')) ?></span>
            <input type="text" name="name" required maxlength="255" autocomplete="name" value="<?= $escaper->escapeHtmlAttr($customer['name']) ?>" class="input input-bordered w-full">
        </label>
        <label class="flex flex-col gap-1 text-sm"><span><?= $escaper->escapeHtml(__('Email')) ?></span>
            <input type="email" name="email" required maxlength="255" autocomplete="email" value="<?= $escaper->escapeHtmlAttr($customer['email']) ?>" class="input input-bordered w-full">
        </label>
        <label class="flex flex-col gap-1 text-sm"><span><?= $escaper->escapeHtml(__('Phone (optional)')) ?></span>
            <input type="tel" name="phone" maxlength="64" autocomplete="tel" class="input input-bordered w-full">
        </label>
        <label class="flex flex-col gap-1 text-sm"><span><?= $escaper->escapeHtml(__('Company (optional)')) ?></span>
            <input type="text" name="company" maxlength="255" autocomplete="organization" class="input input-bordered w-full">
        </label>
        <label class="flex flex-col gap-1 text-sm"><span><?= $escaper->escapeHtml(__('Anything we should know')) ?></span>
            <textarea name="comment" rows="4" maxlength="4000" class="textarea textarea-bordered w-full"
                      placeholder="<?= $escaper->escapeHtmlAttr(__('Quantities, delivery dates, a price you have in mind')) ?>"></textarea>
        </label>
        <?= $block->getChildHtml('captcha') ?>
        <button type="submit" class="btn btn-neutral"><?= $escaper->escapeHtml(__('Send Request')) ?></button>
        <p class="text-xs text-base-content/60"><?= $escaper->escapeHtml(__('We email you a quote with a link: accept it to check out at those prices.')) ?></p>
    </form>
</div>
