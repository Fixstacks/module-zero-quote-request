<div id="zero-quote-product" class="zero-quote-product flex flex-col gap-3 rounded-box border border-base-300 p-4 my-4" data-quote-product>
    <p class="font-medium"><?= $escaper->escapeHtml(__('Ask us for a price')) ?></p>
