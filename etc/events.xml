<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="catalog_product_type_prepare_full_options">
        <observer name="zero_quote_request_guard" instance="Zero\QuoteRequest\Observer\GuardQuoteOnly"/>
    </event>
    <event name="sales_quote_collect_totals_before">
        <observer name="zero_quote_request_qty" instance="Zero\QuoteRequest\Observer\KeepQuotedQty"/>
    </event>
    <event name="sales_model_service_quote_submit_success">
        <observer name="zero_quote_request_ordered" instance="Zero\QuoteRequest\Observer\MarkOrdered"/>
    </event>
</config>
